<Window x:Class="PdfNote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF Note" Width="1240" Height="820" MinWidth="720" MinHeight="480"
        Icon="Assets/app.ico" AllowDrop="True" FontFamily="{StaticResource UiFont}"
        Drop="Window_Drop" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="TabItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="TabBar" Grid.Row="0" Background="#FFE4E7EC" BorderBrush="#FFC8CCD4" BorderThickness="0,0,0,1">
            <DockPanel Margin="4,3">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="메뉴 ▾" Padding="12,5" Margin="2" Click="MenuBtn_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="열기" Padding="12,5" Margin="2" Click="Open_Click" ToolTip="Ctrl+O"/>
                    <Button Content="새 노트" Padding="12,5" Margin="2" Click="NewNote_Click" ToolTip="Ctrl+N"/>
                </StackPanel>
                <ListBox x:Name="Tabs" Background="Transparent" BorderThickness="0" Margin="6,0,0,0"
                         ItemContainerStyle="{StaticResource TabItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         SelectionChanged="Tabs_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Button Content="×" Margin="8,0,0,0" Padding="4,0" Click="TabClose_Click" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand" ToolTip="닫기 (Ctrl+W)">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHome}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl x:Name="ContentHost" Grid.Row="1" IsTabStop="False"/>
        <TextBlock x:Name="BusyText" Grid.Row="1" Text="여는 중…" FontSize="16" Foreground="#FF37474F"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
</Window>
