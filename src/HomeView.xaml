<UserControl x:Class="PdfNote.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <Grid Background="#FFF7F8FA">
        <Grid Margin="28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="PDF Note" FontSize="28" FontWeight="Bold" Foreground="#FF263238"/>
                <TextBlock Text="PDF 읽기 · 펜 필기 · 하이라이트 · 메모 — 필기 노트북용 가벼운 노트 앱"
                           Foreground="#FF607D8B" Margin="0,2,0,12"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="PDF 열기" Padding="16,7" Margin="0,0,8,0" Click="Open_Click"/>
                    <Button Content="새 노트" Padding="16,7" Margin="0,0,8,0" Click="New_Click"/>
                    <Button Content="문서함 폴더 열기" Padding="16,7" Click="Library_Click"/>
                </StackPanel>
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="최근 문서" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="RecentEmpty" DockPanel.Dock="Top" Text="아직 연 문서가 없습니다. PDF를 끌어다 놓아도 열립니다."
                               Foreground="#FF90A4AE" Margin="0,4"/>
                    <ListBox x:Name="RecentList" MouseDoubleClick="List_DoubleClick" KeyDown="List_KeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,5">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Sub}" Foreground="#FF78909C" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="목록에서 제거" Click="RemoveRecent_Click"/>
                                <MenuItem Header="탐색기에서 보기" Click="Reveal_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Text="문서함 (Documents\PDF Note)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="LibEmpty" DockPanel.Dock="Top" Text="새 노트를 만들면 이곳에 저장됩니다. PDF를 이 폴더에 넣어도 표시됩니다."
                               Foreground="#FF90A4AE" Margin="0,4" TextWrapping="Wrap"/>
                    <ListBox x:Name="LibList" MouseDoubleClick="List_DoubleClick" KeyDown="List_KeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,5">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Sub}" Foreground="#FF78909C" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
