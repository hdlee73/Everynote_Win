<UserControl x:Class="PdfNote.DocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FontFamily="{StaticResource UiFont}">
    <UserControl.Resources>
        <Style x:Key="ToolBtn" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="MinWidth" Value="40"/>
        </Style>
        <Style x:Key="PlainBtn" TargetType="Button">
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="MinWidth" Value="32"/>
        </Style>
        <DataTemplate x:Key="ThumbTemplate">
            <StackPanel Margin="4">
                <Border Background="White" BorderBrush="#FFBBBBBB" BorderThickness="1" MinHeight="150" Width="124">
                    <Image Source="{Binding Image}" Width="120" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Toolbar ===== -->
        <Border Grid.Row="0" x:Name="ToolbarBorder" Background="#FFF3F4F6" BorderBrush="#FFD0D3D8" BorderThickness="0,0,0,1">
            <WrapPanel Margin="4,2" VerticalAlignment="Center">
                <ToggleButton x:Name="PanelToggle" Content="패널" Margin="2" Padding="9,4"
                              Checked="PanelToggle_Changed" Unchecked="PanelToggle_Changed"/>
                <Rectangle Width="1" Fill="#FFCCCCCC" Margin="6,4"/>
                <RadioButton x:Name="BtnRead" Content="이동" Tag="Read" GroupName="tool" Style="{StaticResource ToolBtn}" Checked="Tool_Checked" ToolTip="읽기 · 이동 · 확대 (Esc)"/>
                <RadioButton x:Name="BtnPen" Content="펜" Tag="Pen" GroupName="tool" Style="{StaticResource ToolBtn}" Checked="Tool_Checked" ToolTip="펜 (필압 지원)"/>
                <RadioButton x:Name="BtnHl" Content="형광펜" Tag="Highlighter" GroupName="tool" Style="{StaticResource ToolBtn}" Checked="Tool_Checked"/>
                <RadioButton x:Name="BtnEraser" Content="지우개" Tag="Eraser" GroupName="tool" Style="{StaticResource ToolBtn}" Checked="Tool_Checked" ToolTip="획 지우개 (펜 뒷면도 지우개로 동작)"/>
                <RadioButton x:Name="BtnLasso" Content="올가미" Tag="Lasso" GroupName="tool" Style="{StaticResource ToolBtn}" Checked="Tool_Checked" ToolTip="필기 선택 · 이동 · 삭제 (Delete)"/>
                <RadioButton x:Name="BtnText" Content="글자선택" Tag="TextSelect" GroupName="tool" Style="{StaticResource ToolBtn}" Checked="Tool_Checked" ToolTip="드래그로 문장 선택 → 하이라이트·복사·번역·읽기"/>
                <RadioButton x:Name="BtnTyping" Content="타이핑" Tag="Typing" GroupName="tool" Style="{StaticResource ToolBtn}" Checked="Tool_Checked" ToolTip="페이지를 눌러 글자 입력 (글꼴·크기·색 지정)"/>
                <RadioButton x:Name="BtnMemo" Content="메모" Tag="Memo" GroupName="tool" Style="{StaticResource ToolBtn}" Checked="Tool_Checked" ToolTip="누른 위치에 포스트잇 추가"/>
                <RadioButton x:Name="BtnOutline" Content="개요+" Tag="Outline" GroupName="tool" Style="{StaticResource ToolBtn}" Checked="Tool_Checked" ToolTip="누른 위치에 제목(개요) 추가"/>
                <RadioButton x:Name="BtnCapture" Content="캡처" Tag="Capture" GroupName="tool" Style="{StaticResource ToolBtn}" Checked="Tool_Checked" ToolTip="영역을 드래그해 이미지 복사·저장"/>
                <Button x:Name="InsertBtn" Content="삽입 ▾" Style="{StaticResource PlainBtn}" Click="Insert_Click"
                        ToolTip="사진·스티커·도형·표·링크 삽입 (빈 곳을 길게 눌러도 열립니다)"/>
                <Rectangle Width="1" Fill="#FFCCCCCC" Margin="6,4"/>
                <ComboBox x:Name="LassoShapeBox" Width="76" Margin="2" VerticalAlignment="Center" Visibility="Collapsed"
                          SelectedIndex="0" SelectionChanged="LassoShape_Changed" ToolTip="올가미 모양">
                    <ComboBoxItem Content="자유 올가미"/>
                    <ComboBoxItem Content="사각형"/>
                    <ComboBoxItem Content="원"/>
                </ComboBox>
                <StackPanel x:Name="TypingPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                    <ComboBox x:Name="TFontBox" Width="72" Margin="2" SelectionChanged="TFormat_Changed" ToolTip="글꼴"/>
                    <ToggleButton x:Name="TBoldBtn" Content="B" FontWeight="Bold" Width="26" Margin="2" Checked="TFormat_Changed" Unchecked="TFormat_Changed" ToolTip="굵게"/>
                    <ToggleButton x:Name="TItalicBtn" Content="I" FontStyle="Italic" Width="26" Margin="2" Checked="TFormat_Changed" Unchecked="TFormat_Changed" ToolTip="기울임"/>
                    <ComboBox x:Name="TSizeBox" Width="54" Margin="2" SelectionChanged="TFormat_Changed" ToolTip="글자 크기 (8–72pt)"/>
                    <StackPanel x:Name="TColorPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="PenColorPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                <StackPanel x:Name="HlColorPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed"/>
                <Slider x:Name="WidthSlider" Width="80" Minimum="1" Maximum="12" Value="2.5" VerticalAlignment="Center"
                        Margin="6,0" ValueChanged="WidthSlider_Changed" ToolTip="굵기"/>
                <Rectangle Width="1" Fill="#FFCCCCCC" Margin="6,4"/>
                <Button x:Name="UndoBtn" Content="↶ 실행취소" Style="{StaticResource PlainBtn}" Click="Undo_Click" ToolTip="Ctrl+Z"/>
                <Button x:Name="RedoBtn" Content="↷ 다시" Style="{StaticResource PlainBtn}" Click="Redo_Click" ToolTip="Ctrl+Y"/>
                <CheckBox x:Name="FingerChk" Content="손가락 필기" VerticalAlignment="Center" Margin="8,0"
                          Checked="Finger_Changed" Unchecked="Finger_Changed"
                          ToolTip="끄면 손가락 터치는 이동/스크롤, 펜만 필기 (손바닥 오입력 방지)"/>
                <Rectangle Width="1" Fill="#FFCCCCCC" Margin="6,4"/>
                <Button Content="−" Style="{StaticResource PlainBtn}" Click="ZoomOut_Click" ToolTip="축소 (Ctrl+휠)"/>
                <TextBlock x:Name="ZoomLabel" Text="100%" VerticalAlignment="Center" MinWidth="44" TextAlignment="Center"/>
                <Button Content="+" Style="{StaticResource PlainBtn}" Click="ZoomIn_Click" ToolTip="확대 (Ctrl+휠)"/>
                <Button Content="폭 맞춤" Style="{StaticResource PlainBtn}" Click="Fit_Click" ToolTip="Ctrl+0"/>
                <CheckBox x:Name="HideMemosChk" Content="메모 숨김" VerticalAlignment="Center" Margin="8,0"
                          Checked="HideMemos_Changed" Unchecked="HideMemos_Changed"/>
            </WrapPanel>
        </Border>

        <!-- ===== Main area ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideCol" Width="250"/>
                <ColumnDefinition x:Name="SplitCol" Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TabControl x:Name="SideTabs" Grid.Column="0" Padding="0" BorderThickness="0,0,1,0">
                <TabItem Header="페이지">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="2">
                            <ToggleButton x:Name="ThumbBmOnly" Content="★ 즐겨찾기만" Margin="2" Padding="6,3"
                                          Checked="ThumbFilter_Changed" Unchecked="ThumbFilter_Changed"/>
                            <Button x:Name="AddPageBtn" Content="＋ 페이지" Margin="2" Padding="6,3" Click="AddPage_Click"
                                    ToolTip="현재 페이지 뒤에 빈 페이지 추가 (노트 전용)"/>
                            <Button x:Name="DelPageBtn" Content="페이지 삭제" Margin="2" Padding="6,3" Click="DelPage_Click"
                                    ToolTip="현재 페이지 삭제 (노트 전용)"/>
                        </WrapPanel>
                        <ListBox x:Name="ThumbList" ItemTemplate="{StaticResource ThumbTemplate}"
                                 HorizontalContentAlignment="Center" SelectionChanged="ThumbList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </DockPanel>
                </TabItem>
                <TabItem Header="개요">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="선택한 내 개요 삭제" Margin="4" Padding="4" Click="OutlineDelete_Click"/>
                        <ListBox x:Name="OutlineList" SelectionChanged="OutlineList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" Margin="2,3"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
                <TabItem Header="즐겨찾기">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="선택 삭제" Margin="4" Padding="4" Click="BookmarkDelete_Click"/>
                        <ListBox x:Name="BookmarkList" SelectionChanged="BookmarkList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" Margin="2,4"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
                <TabItem Header="노트">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="2">
                            <Button Content="Markdown" Margin="2" Padding="6,3" Click="ExportMd_Click"/>
                            <Button Content="CSV" Margin="2" Padding="6,3" Click="ExportCsv_Click"/>
                            <Button Content="Anki" Margin="2" Padding="6,3" Click="ExportAnki_Click"/>
                        </WrapPanel>
                        <ListBox x:Name="NotesList" SelectionChanged="NotesList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4">
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Foreground="#FF555555"/>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxHeight="64" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontStyle="Italic" Foreground="#FF1565C0"
                                                   Visibility="{Binding NoteVisible}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
                <TabItem Header="검색" x:Name="SearchTab">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="4">
                            <Button DockPanel.Dock="Right" Content="▼" Padding="6,3" Margin="2,0,0,0" Click="SearchNext_Click" ToolTip="다음 결과"/>
                            <Button DockPanel.Dock="Right" Content="▲" Padding="6,3" Margin="4,0,0,0" Click="SearchPrev_Click" ToolTip="이전 결과"/>
                            <Button DockPanel.Dock="Right" Content="검색" Padding="8,3" Margin="4,0,0,0" Click="Search_Click"/>
                            <TextBox x:Name="SearchBox" Padding="3" KeyDown="SearchBox_KeyDown"/>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" x:Name="SearchStatus" Margin="6,0,6,4" Foreground="#FF666666" TextWrapping="Wrap"/>
                        <ListBox x:Name="SearchList" SelectionChanged="SearchList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" TextWrapping="Wrap" Margin="2,3"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
                <TabItem Header="녹음">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="6">
                            <Button x:Name="RecBtn" Content="● 녹음 시작" Padding="8,6" Click="Rec_Click"
                                    ToolTip="현재 페이지에 연결되는 음성 녹음"/>
                            <TextBlock x:Name="RecStatus" Margin="0,6,0,0" Foreground="#FF666666" TextWrapping="Wrap"/>
                        </StackPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="2">
                            <Button Content="▶ 재생" Margin="2" Padding="8,3" Click="RecPlay_Click"/>
                            <Button Content="■ 정지" Margin="2" Padding="8,3" Click="RecStop_Click"/>
                            <Button Content="삭제" Margin="2" Padding="8,3" Click="RecDelete_Click"/>
                        </WrapPanel>
                        <ListBox x:Name="RecList" MouseDoubleClick="RecList_DoubleClick"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" TextWrapping="Wrap" Margin="2,4"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#FFD8DADF"/>

            <Grid Grid.Column="2" Background="#FF3A3F44">
                <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              PanningMode="Both" CanContentScroll="False" Focusable="False"
                              PreviewMouseWheel="Scroller_PreviewMouseWheel" SizeChanged="Scroller_SizeChanged">
                    <Grid x:Name="Host" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14"
                          ClipToBounds="True" IsManipulationEnabled="True" RenderTransformOrigin="0.5,0.5"
                          PreviewMouseLeftButtonDown="Host_PreviewMouseDown" PreviewMouseMove="Host_PreviewMouseMove"
                          PreviewMouseLeftButtonUp="Host_PreviewMouseUp"
                          ManipulationStarting="Host_ManipulationStarting"
                          ManipulationDelta="Host_ManipulationDelta"
                          ManipulationCompleted="Host_ManipulationCompleted">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="ZoomTf" ScaleX="1" ScaleY="1"/>
                        </Grid.LayoutTransform>
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="FlipTf" X="0" Y="0"/>
                        </Grid.RenderTransform>
                        <Grid x:Name="PageGrid" Width="794" Height="1123" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Border Background="White"/>
                            <Image x:Name="PageImage" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear" IsHitTestVisible="False"/>
                            <Canvas x:Name="HlLayer"/>
                            <InkCanvas x:Name="Ink" Background="Transparent" EditingMode="None" IsHitTestVisible="False"
                                       PreviewStylusDown="Ink_PreviewStylusDown" PreviewStylusUp="Ink_PreviewStylusUp"
                                       SelectionChanged="Ink_SelectionChanged"/>
                            <Canvas x:Name="Overlay" Background="Transparent" IsHitTestVisible="False"
                                    MouseLeftButtonDown="Overlay_MouseDown" MouseMove="Overlay_MouseMove" MouseLeftButtonUp="Overlay_MouseUp"/>
                            <Canvas x:Name="ObjLayer"/>
                            <Canvas x:Name="MemoLayer"/>
                        </Grid>
                    </Grid>
                </ScrollViewer>
                <TextBlock x:Name="LoadingText" Text="불러오는 중…" Foreground="White" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <!-- ===== Bottom bar ===== -->
        <Border Grid.Row="2" x:Name="BottomBorder" Background="#FFF3F4F6" BorderBrush="#FFD0D3D8" BorderThickness="0,1,0,0">
            <DockPanel Margin="6,2">
                <TextBlock DockPanel.Dock="Right" x:Name="StatusText" VerticalAlignment="Center" Foreground="#FF555555" Margin="8,0"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="◀" Style="{StaticResource PlainBtn}" Click="Prev_Click" ToolTip="이전 페이지 (PageUp)"/>
                    <TextBox x:Name="PageBox" Width="48" Padding="2" VerticalAlignment="Center" TextAlignment="Center"
                             KeyDown="PageBox_KeyDown" ToolTip="페이지 번호 입력 후 Enter (Ctrl+G)"/>
                    <TextBlock x:Name="PageTotal" Text=" / 1" VerticalAlignment="Center" Margin="2,0,6,0"/>
                    <Button Content="▶" Style="{StaticResource PlainBtn}" Click="Next_Click" ToolTip="다음 페이지 (PageDown)"/>
                    <Button x:Name="BookmarkBtn" Content="☆ 즐겨찾기" Style="{StaticResource PlainBtn}" Margin="10,2,2,2" Click="Bookmark_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
